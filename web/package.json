{
  "name": "openscm-web",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "node scripts/generate-client.mjs",
    "check:api": "node scripts/generate-client.mjs --check",
    "typecheck": "next typegen && tsc --noEmit",
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx,css}\" \"tests/*.ts\" \"e2e/*.ts\" \"*.ts\" \"*.json\"",
    "record:evidence": "node scripts/record-validation.mjs",
    "start": "next start --hostname 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.4",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "openapi-fetch": "^0.15.0",
    "react": "^19.3.1",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-cytoscapejs": "^1.2.6",
    "@types/react-dom": "^19.3.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
