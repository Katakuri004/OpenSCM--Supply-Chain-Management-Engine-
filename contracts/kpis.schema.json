{
  "$defs": {
    "Estimate": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean"
        },
        "ci95": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci95"
        }
      },
      "required": [
        "mean"
      ],
      "title": "Estimate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "node_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Node Id"
    },
    "replications": {
      "exclusiveMinimum": 0,
      "title": "Replications",
      "type": "integer"
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/Estimate"
      },
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "fill_rate",
          "cycle_service_level",
          "stockout_days",
          "inventory_turns",
          "days_of_inventory",
          "cash_to_cash_days",
          "otif",
          "total_landed_cost_inr",
          "bullwhip_ratio"
        ]
      },
      "title": "Metrics",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "replications",
    "metrics"
  ],
  "title": "Kpis",
  "type": "object"
}
