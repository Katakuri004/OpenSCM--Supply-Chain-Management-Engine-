{
  "$defs": {
    "Query": {
      "additionalProperties": false,
      "properties": {
        "node_type": {
          "anyOf": [
            {
              "enum": [
                "supplier",
                "dc",
                "retailer",
                "b2b"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Type"
        },
        "metric": {
          "enum": [
            "days_of_cover",
            "fill_rate",
            "on_hand",
            "on_order",
            "backorders"
          ],
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "enum": [
            "lt",
            "le",
            "eq",
            "ge",
            "gt"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "operator",
        "value"
      ],
      "title": "Query",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "filter": {
      "anyOf": [
        {
          "$ref": "#/$defs/Query"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "day": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Day"
    }
  },
  "title": "QueryRequest",
  "type": "object"
}
