{
  "$defs": {
    "BullwhipConfig": {
      "additionalProperties": false,
      "properties": {
        "signal_processing": {
          "default": true,
          "title": "Signal Processing",
          "type": "boolean"
        },
        "batching": {
          "default": true,
          "title": "Batching",
          "type": "boolean"
        },
        "price": {
          "default": false,
          "title": "Price",
          "type": "boolean"
        },
        "rationing": {
          "default": false,
          "title": "Rationing",
          "type": "boolean"
        },
        "pos_sharing": {
          "default": false,
          "title": "Pos Sharing",
          "type": "boolean"
        }
      },
      "title": "BullwhipConfig",
      "type": "object"
    },
    "DemandConfig": {
      "additionalProperties": false,
      "properties": {
        "cv_scale": {
          "default": 1.0,
          "minimum": 0,
          "title": "Cv Scale",
          "type": "number"
        },
        "regional_rho": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Regional Rho",
          "type": "number"
        },
        "seasonality": {
          "const": "monthly_index_v1",
          "default": "monthly_index_v1",
          "title": "Seasonality",
          "type": "string"
        }
      },
      "title": "DemandConfig",
      "type": "object"
    },
    "Disruption": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "supplier_outage",
            "lead_time_multiplier",
            "demand_shock",
            "capacity_cut",
            "moq_change",
            "price_promo"
          ],
          "title": "Type",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Target",
          "type": "string"
        },
        "start_day": {
          "minimum": 0,
          "title": "Start Day",
          "type": "integer"
        },
        "duration": {
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "integer"
        },
        "magnitude": {
          "description": "Removed capacity fraction for outage/cut; discount fraction for promo; multiplier otherwise.",
          "minimum": 0,
          "title": "Magnitude",
          "type": "number"
        }
      },
      "required": [
        "type",
        "target",
        "start_day",
        "duration",
        "magnitude"
      ],
      "title": "Disruption",
      "type": "object"
    },
    "JsonValue": {},
    "LabSettings": {
      "additionalProperties": false,
      "properties": {
        "monthly_index": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "number"
              },
              "maxItems": 12,
              "minItems": 12,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monthly Index"
        },
        "suppliers": {
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "$ref": "#/$defs/SupplierAssumptions"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Suppliers",
          "type": "object"
        },
        "skus": {
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "$ref": "#/$defs/SkuAssumptions"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Skus",
          "type": "object"
        },
        "dc_capacity_factor": {
          "default": 1,
          "minimum": 0,
          "title": "Dc Capacity Factor",
          "type": "number"
        },
        "forecast_method": {
          "anyOf": [
            {
              "enum": [
                "moving_average",
                "ses",
                "holt"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forecast Method"
        },
        "forecast_window": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forecast Window"
        },
        "forecast_alpha": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forecast Alpha"
        },
        "forecast_beta": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forecast Beta"
        },
        "buffer_days": {
          "default": 0,
          "minimum": 0,
          "title": "Buffer Days",
          "type": "number"
        },
        "expedite_factor": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Expedite Factor",
          "type": "number"
        },
        "expedite_unit_cost": {
          "default": 0,
          "minimum": 0,
          "title": "Expedite Unit Cost",
          "type": "number"
        },
        "backup_suppliers": {
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Backup Suppliers",
          "type": "object"
        }
      },
      "title": "LabSettings",
      "type": "object"
    },
    "NetworkConfig": {
      "additionalProperties": false,
      "properties": {
        "dc_count": {
          "default": 4,
          "enum": [
            1,
            2,
            4,
            8
          ],
          "title": "Dc Count",
          "type": "integer"
        },
        "suppliers": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Suppliers",
          "type": "array"
        }
      },
      "title": "NetworkConfig",
      "type": "object"
    },
    "PolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "QR",
            "sS",
            "RS",
            "order_up_to"
          ],
          "type": "string",
          "default": "QR",
          "title": "Default"
        },
        "target_csl": {
          "default": 0.95,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Target Csl",
          "type": "number"
        },
        "segmentation": {
          "const": "abc_xyz_v1",
          "default": "abc_xyz_v1",
          "title": "Segmentation",
          "type": "string"
        }
      },
      "title": "PolicyConfig",
      "type": "object"
    },
    "RunOptions": {
      "additionalProperties": false,
      "properties": {
        "forecasting": {
          "default": false,
          "title": "Forecasting",
          "type": "boolean"
        },
        "segmented": {
          "default": false,
          "title": "Segmented",
          "type": "boolean"
        },
        "bullwhip": {
          "default": false,
          "title": "Bullwhip",
          "type": "boolean"
        },
        "lost_sales": {
          "default": false,
          "title": "Lost Sales",
          "type": "boolean"
        }
      },
      "title": "RunOptions",
      "type": "object"
    },
    "RunRequest": {
      "additionalProperties": false,
      "properties": {
        "preset": {
          "default": "base_4dc",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Preset",
          "type": "string"
        },
        "overrides": {
          "$ref": "#/$defs/ScenarioOverrides"
        },
        "seed": {
          "default": 0,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "replications": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Replications",
          "type": "integer"
        },
        "options": {
          "$ref": "#/$defs/RunOptions"
        },
        "lab": {
          "$ref": "#/$defs/LabSettings"
        }
      },
      "title": "RunRequest",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Scenario",
          "type": "string"
        },
        "horizon_days": {
          "default": 365,
          "exclusiveMinimum": 0,
          "title": "Horizon Days",
          "type": "integer"
        },
        "warmup_days": {
          "default": 90,
          "minimum": 0,
          "title": "Warmup Days",
          "type": "integer"
        },
        "replications": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Replications",
          "type": "integer"
        },
        "network": {
          "$ref": "#/$defs/NetworkConfig"
        },
        "demand": {
          "$ref": "#/$defs/DemandConfig"
        },
        "policy": {
          "$ref": "#/$defs/PolicyConfig"
        },
        "bullwhip": {
          "$ref": "#/$defs/BullwhipConfig"
        },
        "disruptions": {
          "items": {
            "$ref": "#/$defs/Disruption"
          },
          "title": "Disruptions",
          "type": "array"
        }
      },
      "required": [
        "scenario"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "ScenarioOverrides": {
      "additionalProperties": false,
      "properties": {
        "horizon_days": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon Days"
        },
        "warmup_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warmup Days"
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "demand": {
          "anyOf": [
            {
              "$ref": "#/$defs/DemandConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PolicyConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bullwhip": {
          "anyOf": [
            {
              "$ref": "#/$defs/BullwhipConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "disruptions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Disruption"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disruptions"
        }
      },
      "title": "ScenarioOverrides",
      "type": "object"
    },
    "SkuAssumptions": {
      "additionalProperties": false,
      "properties": {
        "daily_mean": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Daily Mean"
        },
        "cv": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cv"
        },
        "unit_cost": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Cost"
        },
        "supplier": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supplier"
        },
        "moq": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moq"
        },
        "pack_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pack Size"
        }
      },
      "title": "SkuAssumptions",
      "type": "object"
    },
    "SupplierAssumptions": {
      "additionalProperties": false,
      "properties": {
        "lead_mean": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lead Mean"
        },
        "lead_cv": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lead Cv"
        },
        "delay_probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delay Probability"
        },
        "delay_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delay Days"
        },
        "daily_capacity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Daily Capacity"
        },
        "price_multiplier": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Multiplier"
        },
        "moq": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moq"
        }
      },
      "title": "SupplierAssumptions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/RunRequest"
    },
    "scenario": {
      "$ref": "#/$defs/Scenario"
    },
    "input_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Sha256",
      "type": "object"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    },
    "settings": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Settings",
      "type": "object"
    },
    "replication_seeds": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Replication Seeds",
      "type": "array"
    },
    "training_seed": {
      "minimum": 0,
      "title": "Training Seed",
      "type": "integer"
    },
    "operating_snapshot": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operating Snapshot"
    }
  },
  "required": [
    "run_id",
    "request",
    "scenario",
    "input_sha256",
    "versions",
    "settings",
    "replication_seeds",
    "training_seed"
  ],
  "title": "RunProvenance",
  "type": "object"
}
