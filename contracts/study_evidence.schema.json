      "type": "object"
    },
    "Kpis": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Run Id",
          "type": "string"
