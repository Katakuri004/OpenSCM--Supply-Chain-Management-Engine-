{
  "$defs": {
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "run_a": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Run A",
          "type": "string"
        },
        "run_b": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Run B",
          "type": "string"
        },
        "replications": {
          "exclusiveMinimum": 0,
          "title": "Replications",
          "type": "integer"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/Estimate"
          },
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "fill_rate",
              "cycle_service_level",
              "stockout_days",
              "inventory_turns",
              "days_of_inventory",
              "cash_to_cash_days",
              "otif",
              "total_landed_cost_inr",
              "bullwhip_ratio"
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "costs": {
          "$ref": "#/$defs/CostComparison"
        }
      },
      "required": [
        "run_a",
        "run_b",
        "replications",
        "metrics",
        "costs"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "CostComparison": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Component",
          "type": "array"
        },
        "a": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "A",
          "type": "array"
        },
        "b": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "B",
          "type": "array"
        },
        "delta": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Delta",
          "type": "array"
        },
        "ci95_low": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Ci95 Low",
          "type": "array"
        },
        "ci95_high": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Ci95 High",
          "type": "array"
        }
      },
      "required": [
        "component",
        "a",
        "b",
        "delta",
        "ci95_low",
        "ci95_high"
      ],
      "title": "CostComparison",
      "type": "object"
    },
    "Disruption": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "supplier_outage",
            "lead_time_multiplier",
            "demand_shock",
            "capacity_cut",
            "moq_change",
            "price_promo"
          ],
          "title": "Type",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Target",
          "type": "string"
        },
        "start_day": {
          "minimum": 0,
          "title": "Start Day",
          "type": "integer"
        },
        "duration": {
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "integer"
        },
        "magnitude": {
          "description": "Removed capacity fraction for outage/cut; discount fraction for promo; multiplier otherwise.",
          "minimum": 0,
          "title": "Magnitude",
          "type": "number"
        }
      },
      "required": [
        "type",
        "target",
        "start_day",
        "duration",
        "magnitude"
      ],
      "title": "Disruption",
      "type": "object"
    },
    "Edges": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Id",
          "type": "array"
        },
        "source": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Source",
          "type": "array"
        },
        "target": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Target",
          "type": "array"
        },
        "distance_km": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Distance Km",
          "type": "array"
        },
        "flow_units": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Flow Units",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "distance_km",
        "flow_units"
      ],
      "title": "Edges",
      "type": "object"
    },
    "Estimate": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean"
        },
        "ci95": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci95"
        }
      },
      "required": [
        "mean"
      ],
      "title": "Estimate",
      "type": "object"
    },
    "EventControl": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Target",
          "type": "string"
        },
        "neutral": {
          "minimum": 0,
          "title": "Neutral",
          "type": "number"
        },
        "minimum": {
          "minimum": 0,
          "title": "Minimum",
          "type": "number"
        },
        "maximum": {
          "minimum": 0,
          "title": "Maximum",
          "type": "number"
        },
        "step": {
          "exclusiveMinimum": 0,
          "title": "Step",
          "type": "number"
        }
      },
      "required": [
        "type",
        "target",
        "neutral",
        "minimum",
        "maximum",
        "step"
      ],
      "title": "EventControl",
      "type": "object"
    },
    "InventoryExample": {
      "additionalProperties": false,
      "properties": {
        "annual_demand": {
          "minimum": 0,
          "title": "Annual Demand",
          "type": "number"
        },
        "order_cost": {
          "exclusiveMinimum": 0,
          "title": "Order Cost",
          "type": "number"
        },
        "holding_cost": {
          "exclusiveMinimum": 0,
          "title": "Holding Cost",
          "type": "number"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "series": {
          "$ref": "#/$defs/ObservationSeries"
        }
      },
      "required": [
        "annual_demand",
        "order_cost",
        "holding_cost",
        "quantity",
        "series"
      ],
