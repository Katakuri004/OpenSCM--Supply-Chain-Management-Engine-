    "Nodes": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Id",
          "type": "array"
        },
        "label": {
          "items": {
            "type": "string"
          },
          "title": "Label",
          "type": "array"
