        "replications": {
          "exclusiveMinimum": 0,
          "title": "Replications",
          "type": "integer"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/Estimate"
          },
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "fill_rate",
              "cycle_service_level",
              "stockout_days",
              "inventory_turns",
              "days_of_inventory",
              "cash_to_cash_days",
              "otif",
              "total_landed_cost_inr",
              "bullwhip_ratio"
            ]
          },
          "title": "Metrics",
          "type": "object"
