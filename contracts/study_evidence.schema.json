          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "title": "Days",
          "type": "array"
        },
        "columns": {
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            }
          },
