{
  "$defs": {
    "BullwhipConfig": {
      "additionalProperties": false,
      "properties": {
        "signal_processing": {
          "default": true,
          "title": "Signal Processing",
          "type": "boolean"
        },
        "batching": {
          "default": true,
          "title": "Batching",
          "type": "boolean"
        },
        "price": {
          "default": false,
          "title": "Price",
          "type": "boolean"
        },
        "rationing": {
          "default": false,
          "title": "Rationing",
          "type": "boolean"
        },
        "pos_sharing": {
          "default": false,
          "title": "Pos Sharing",
          "type": "boolean"
        }
      },
      "title": "BullwhipConfig",
      "type": "object"
    },
    "DemandConfig": {
      "additionalProperties": false,
      "properties": {
        "cv_scale": {
          "default": 1.0,
          "minimum": 0,
          "title": "Cv Scale",
          "type": "number"
        },
        "regional_rho": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Regional Rho",
          "type": "number"
        },
        "seasonality": {
          "const": "monthly_index_v1",
          "default": "monthly_index_v1",
          "title": "Seasonality",
          "type": "string"
        }
      },
      "title": "DemandConfig",
      "type": "object"
    },
    "Disruption": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "supplier_outage",
            "lead_time_multiplier",
            "demand_shock",
            "capacity_cut",
            "moq_change",
            "price_promo"
          ],
          "title": "Type",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Target",
          "type": "string"
        },
        "start_day": {
          "minimum": 0,
          "title": "Start Day",
          "type": "integer"
        },
        "duration": {
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "integer"
        },
        "magnitude": {
          "description": "Removed capacity fraction for outage/cut; discount fraction for promo; multiplier otherwise.",
          "minimum": 0,
          "title": "Magnitude",
          "type": "number"
        }
      },
      "required": [
        "type",
        "target",
        "start_day",
        "duration",
        "magnitude"
      ],
      "title": "Disruption",
      "type": "object"
    },
    "NetworkConfig": {
      "additionalProperties": false,
      "properties": {
        "dc_count": {
          "default": 4,
          "maximum": 32,
          "minimum": 1,
          "title": "Dc Count",
          "type": "integer"
        },
        "suppliers": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Suppliers",
          "type": "array"
        }
      },
      "title": "NetworkConfig",
      "type": "object"
    },
    "PolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "QR",
            "sS",
            "RS",
            "order_up_to"
          ],
          "type": "string",
          "default": "QR",
          "title": "Default"
        },
        "target_csl": {
          "default": 0.95,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Target Csl",
          "type": "number"
        },
        "segmentation": {
          "const": "abc_xyz_v1",
          "default": "abc_xyz_v1",
          "title": "Segmentation",
          "type": "string"
        }
      },
      "title": "PolicyConfig",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Scenario",
          "type": "string"
        },
        "horizon_days": {
          "default": 365,
          "exclusiveMinimum": 0,
          "title": "Horizon Days",
          "type": "integer"
        },
        "warmup_days": {
          "default": 90,
          "minimum": 0,
          "title": "Warmup Days",
          "type": "integer"
        },
        "replications": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Replications",
          "type": "integer"
        },
        "network": {
          "$ref": "#/$defs/NetworkConfig"
        },
        "demand": {
          "$ref": "#/$defs/DemandConfig"
        },
        "policy": {
          "$ref": "#/$defs/PolicyConfig"
        },
        "bullwhip": {
          "$ref": "#/$defs/BullwhipConfig"
        },
        "disruptions": {
          "items": {
            "$ref": "#/$defs/Disruption"
          },
          "title": "Disruptions",
          "type": "array"
        }
      },
      "required": [
        "scenario"
      ],
      "title": "Scenario",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "presets": {
      "patternProperties": {
        "^[A-Za-z0-9_-]+$": {
          "$ref": "#/$defs/Scenario"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Presets",
      "type": "object"
    }
  },
  "required": [
    "presets"
  ],
  "title": "ScenarioCatalog",
  "type": "object"
}
