          "propertyNames": {
            "minLength": 1
          },
          "title": "Suppliers",
          "type": "object"
        },
        "skus": {
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "$ref": "#/$defs/SkuAssumptions"
