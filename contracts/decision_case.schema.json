          "minimum": 0,
          "title": "Handling Cost",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "latitude",
        "longitude",
        "daily_capacity",
        "annual_fixed_cost",
        "holding_rate",
        "handling_cost"
