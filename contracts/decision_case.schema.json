        "target_csl": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Target Csl",
          "type": "number"
        },
        "shortage_penalty": {
          "minimum": 0,
          "title": "Shortage Penalty",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "latitude",
        "longitude",
        "kind",
        "region",
        "demand_scale",
        "arrival_probability",
        "target_csl",
        "shortage_penalty"
      ],
      "title": "Customer",
      "type": "object"
    },
    "DC": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
