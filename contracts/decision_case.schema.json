              "type": "null"
            }
          ],
          "default": null,
          "title": "Inventory Ceiling Days"
        }
      },
      "title": "CaseGoals",
      "type": "object"
    },
    "Customer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "kind": {
          "enum": [
            "retailer",
            "b2b"
          ],
          "title": "Kind",
          "type": "string"
        },
        "region": {
          "minimum": 0,
          "title": "Region",
          "type": "integer"
        },
        "demand_scale": {
          "exclusiveMinimum": 0,
          "title": "Demand Scale",
          "type": "number"
        },
        "arrival_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Arrival Probability",
          "type": "number"
