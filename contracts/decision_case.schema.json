        "start_day": {
          "minimum": 0,
          "title": "Start Day",
          "type": "integer"
        },
        "duration": {
          "exclusiveMinimum": 0,
          "title": "Duration",
          "type": "integer"
        },
        "magnitude": {
          "description": "Removed capacity fraction for outage/cut; discount fraction for promo; multiplier otherwise.",
          "minimum": 0,
          "title": "Magnitude",
          "type": "number"
        }
      },
      "required": [
        "type",
        "target",
        "start_day",
        "duration",
        "magnitude"
      ],
      "title": "Disruption",
      "type": "object"
    },
    "Inventory": {
      "additionalProperties": false,
      "properties": {
        "dc_order_cost": {
          "exclusiveMinimum": 0,
          "title": "Dc Order Cost",
          "type": "number"
        },
        "customer_order_cost": {
          "exclusiveMinimum": 0,
          "title": "Customer Order Cost",
          "type": "number"
        },
        "customer_holding_rate": {
          "exclusiveMinimum": 0,
          "title": "Customer Holding Rate",
          "type": "number"
        },
        "review_days": {
          "exclusiveMinimum": 0,
          "title": "Review Days",
          "type": "integer"
        },
        "initial_stock_fraction": {
          "minimum": 0,
          "title": "Initial Stock Fraction",
          "type": "number"
        }
