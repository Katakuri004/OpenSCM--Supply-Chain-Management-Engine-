        "regional_rho": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Regional Rho",
          "type": "number"
        },
        "seasonality": {
          "const": "monthly_index_v1",
          "default": "monthly_index_v1",
          "title": "Seasonality",
          "type": "string"
        }
      },
      "title": "DemandConfig",
      "type": "object"
    },
    "Disruption": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "supplier_outage",
            "lead_time_multiplier",
            "demand_shock",
            "capacity_cut",
            "moq_change",
            "price_promo"
