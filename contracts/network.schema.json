{
  "$defs": {
    "Edges": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Id",
          "type": "array"
        },
        "source": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Source",
          "type": "array"
        },
        "target": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Target",
          "type": "array"
        },
        "distance_km": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Distance Km",
          "type": "array"
        },
        "flow_units": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Flow Units",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "distance_km",
        "flow_units"
      ],
      "title": "Edges",
      "type": "object"
    },
    "Nodes": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Id",
          "type": "array"
        },
        "label": {
          "items": {
            "type": "string"
          },
          "title": "Label",
          "type": "array"
        },
        "type": {
          "items": {
            "enum": [
              "supplier",
              "dc",
              "retailer",
              "b2b"
            ],
            "type": "string"
          },
          "title": "Type",
          "type": "array"
        },
        "latitude": {
          "items": {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "title": "Latitude",
          "type": "array"
        },
        "longitude": {
          "items": {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          },
          "title": "Longitude",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "type",
        "latitude",
        "longitude"
      ],
      "title": "Nodes",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "nodes": {
      "$ref": "#/$defs/Nodes"
    },
    "edges": {
      "$ref": "#/$defs/Edges"
    }
  },
  "required": [
    "run_id",
    "nodes",
    "edges"
  ],
  "title": "Network",
  "type": "object"
}
